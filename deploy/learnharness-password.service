[Unit]
Description=LearnHarness narrow password change helper
After=caddy.service

[Service]
Type=simple
User=root
Group=learnharness
RuntimeDirectory=learnharness-password
RuntimeDirectoryMode=0750
StateDirectory=learnharness-password
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/learnharness/helpers/password-helper.py
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/caddy /run/learnharness-password /var/lib/learnharness-password
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
